# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。

# provider: openai | anthropic
AGENT_PROVIDER=openai

# 模型名（按 provider 填写实际可用模型）
AGENT_MODEL=gpt-4o-mini

# API Key。留空则从 provider 默认环境变量读取
#   openai    -> OPENAI_API_KEY
#   anthropic -> ANTHROPIC_API_KEY
AGENT_API_KEY=

# 自定义网关地址。留空使用官方地址
#   openai    -> https://api.openai.com/v1
#   anthropic -> https://api.anthropic.com
AGENT_BASE_URL=

# 单轮最多执行多少次「模型 -> 工具 -> 模型」往返，防止死循环
AGENT_MAX_TOOL_ROUNDS=8

# 单次模型请求超时（秒）
AGENT_REQUEST_TIMEOUT_S=120

# 单个工具调用超时（秒）
AGENT_TOOL_TIMEOUT_S=30

# 会话事件日志目录（append-only JSONL）
AGENT_DATA_DIR=.data
